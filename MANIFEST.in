include LICENSE NOTICE README.md README.zh-CN.md AGENTS.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
recursive-include src *.py *.json py.typed
recursive-include scripts *.py *.ps1
recursive-include requirements *.txt
recursive-include docs *.md
recursive-include tests *.py *.png *.json
recursive-include tests/fixtures/benchmark *.txt *.md
recursive-include eval/benchmarks *.json *.jsonl *.md *.log
recursive-include experiments/native_regression *.py
recursive-include eval/g1 *.json *.md *.gz
global-exclude *.py[cod]
global-exclude __pycache__
